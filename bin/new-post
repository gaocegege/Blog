#!/usr/bin/env python3
"""Create a blog post with the repository's canonical front matter."""

from __future__ import annotations

import argparse
import json
import re
from datetime import date
from pathlib import Path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Create a new Jekyll post")
    parser.add_argument("slug", help="URL slug, using lowercase letters, numbers and hyphens")
    parser.add_argument("title", help="Post title")
    parser.add_argument("--category", required=True, help="Primary category used by the legacy permalink")
    parser.add_argument("--section", choices=("tech", "life"), default="tech")
    return parser.parse_args()


def yaml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def main() -> None:
    args = parse_args()
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", args.slug):
        raise SystemExit("slug must contain only lowercase letters, numbers and single hyphens")

    today = date.today().isoformat()
    repository = Path(__file__).resolve().parents[1]
    destination = repository / "_posts" / f"{today}-{args.slug}.md"
    if destination.exists():
        raise SystemExit(f"post already exists: {destination}")

    content = f"""---
layout: post
title: {yaml_string(args.title)}
description:
headline:
modified: {today}
category: {yaml_string(args.category)}
tags: []
section: {args.section}
imagefeature:
mathjax: false
chart: false
comments: true
---

## License

- This article is licensed under [CC BY-NC-SA 3.0](https://creativecommons.org/licenses/by-nc-sa/3.0/).
- Please contact me for commercial use.
"""
    destination.write_text(content, encoding="utf-8")
    print(destination.relative_to(repository))


if __name__ == "__main__":
    main()
